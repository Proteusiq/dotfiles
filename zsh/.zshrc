# Interactive shells only. Environment and PATH live in ~/.zshenv.

# Start tmux before any other work, so the outer shell stays cheap. Skipped inside
# tmux, over SSH, for `zsh -c`, and outside Ghostty (IDEs, agents, other terminals).
if [[ -z "$TMUX" && -z "$SSH_CONNECTION" && -z "$ZSH_EXECUTION_STRING" && -z "$DOTFILES_NO_TMUX" ]] &&
    [[ "$TERM_PROGRAM" == "ghostty" ]] && (( $+commands[tmux] )); then
    exec tmux
fi

ZSH_CONFIG_DIR="$XDG_CONFIG_HOME/zsh"
ZSH_CACHE_DIR="$XDG_CACHE_HOME/zsh"
[[ -d "$ZSH_CACHE_DIR/completions" ]] || mkdir -p "$ZSH_CACHE_DIR/completions"

# GNU tools under their usual names. Interactive only, so scripts keep BSD tools.
if [[ -n "$HOMEBREW_PREFIX" ]]; then
    path=("$HOMEBREW_PREFIX"/opt/{coreutils,findutils,gnu-sed,gnu-tar,grep,gawk}/libexec/gnubin(N-/) $path)
fi

HISTSIZE=50000
SAVEHIST=50000
setopt EXTENDED_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS SHARE_HISTORY
setopt AUTO_CD INTERACTIVE_COMMENTS

# Plugins: list in plugins.txt, antidote compiles them into one static file.
if [[ -r "$HOMEBREW_PREFIX/opt/antidote/share/antidote/antidote.zsh" ]]; then
    zstyle ':antidote:bundle' use-friendly-names yes
    source "$HOMEBREW_PREFIX/opt/antidote/share/antidote/antidote.zsh"
    antidote load "$ZSH_CONFIG_DIR/plugins.txt" "$ZSH_CACHE_DIR/plugins.zsh"
fi

# Completions generated by tools are cached and only rebuilt when the tool changes.
cache_completion() {
    local command_name="$1" target="$ZSH_CACHE_DIR/completions/_$1"
    shift
    (( $+commands[$command_name] )) || return 0
    [[ -s "$target" && "$target" -nt "${commands[$command_name]}" ]] && return 0
    "$@" >|"$target" 2>/dev/null
}
cache_completion uv uv generate-shell-completion zsh
cache_completion uvx uvx --generate-shell-completion zsh
cache_completion pixi pixi completion --shell zsh
cache_completion mise mise completion zsh

fpath=("$ZSH_CACHE_DIR/completions" "$HOME/.zfunc"(N-/) "$HOMEBREW_PREFIX/share/zsh/site-functions"(N-/) $fpath)

# One compinit per shell. Full check at most once a day, otherwise use the cache.
autoload -Uz compinit
() {
    local dump="$ZSH_CACHE_DIR/zcompdump"
    local -a stale=("$dump"(N.mh+24))
    if [[ ! -s "$dump" || ${#stale} -gt 0 ]]; then
        compinit -i -d "$dump"
        zcompile "$dump"
    else
        compinit -C -d "$dump"
    fi
}
zstyle ':completion:*' menu select

(( $+commands[mise] )) && eval "$(mise activate zsh)"
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"
(( $+commands[starship] )) && eval "$(starship init zsh)"
(( $+commands[pay-respects] )) && eval "$(pay-respects zsh --alias f)"
[[ -r "$XDG_CONFIG_HOME/broot/launcher/bash/br" ]] && source "$XDG_CONFIG_HOME/broot/launcher/bash/br"

source "$ZSH_CONFIG_DIR/fzf.zsh"
source "$ZSH_CONFIG_DIR/aliases.zsh"
source "$ZSH_CONFIG_DIR/functions.zsh"

# Atuin last, so it owns Ctrl-R and the up arrow.
(( $+commands[atuin] )) && eval "$(atuin init zsh)"

# Machine-local settings and lines that installers append. Not tracked.
[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
